#!/bin/sh
# Generated by reconf - configure script

PACKAGE_NAME="reconf"
PACKAGE_VERSION="0.1.0"
CC="${CC:-${CC:-gcc}}"
CFLAGS="${CFLAGS:--Wall -Wextra -Wno-unused -O3 -std=c99 -nostdlib -fno-builtin}"
INCLUDES="${INCLUDES:--Iinclude/ }"
LDFLAGS="${LDFLAGS:-obj/dmalloc.a}"
CC="${CC:-gcc}"
CFLAGS="${CFLAGS:--O2}"
LDFLAGS="${LDFLAGS:-}"

mkdir -p build/obj

rm -f build/config.h
echo "/* Auto-generated by ./configure */" > build/config.h
echo "#ifndef CONFIG_H" >> build/config.h
echo "#define CONFIG_H" >> build/config.h

printf "Checking C compiler ($CC)... "
if command -v "$CC" >/dev/null 2>&1; then echo "yes"; else echo "no"; exit 1; fi

echo "#endif" >> build/config.h

cat << 'EOF' > build/rules.ninja
rule compile
  command = $CC $CFLAGS $INCLUDES -I../include -I.. -I. -MF $out.d -MMD -MP -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = Compiling $out

rule link_bin
  command = $CC -o $out $in $LDFLAGS
  description = Linking binary $out

rule link_shared
  command = $CC -shared -o $out $in $LDFLAGS
  description = Linking $out

rule link_static
  command = ar rcs $out $in
  description = Linking $out

rule custom_cmd
  command = $cmd
  description = Running custom rule: $out

EOF

cat << EOF > build/build.ninja
include rules.ninja

CC = $CC
CFLAGS = $CFLAGS
INCLUDES = $INCLUDES
LDFLAGS = $LDFLAGS

build obj/dmalloc.a: custom_cmd
  cmd = make -C ../lib/dmalloc CC="$CC" CFLAGS="$CFLAGS" && cp ../lib/dmalloc/build/dmalloc.a obj/

default
EOF

echo "Configuration complete. Run 'ninja -C build' to build."
